# ============================================================
# ofenes — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# All variables have sensible defaults for local development.
# ============================================================

# --- Domain ---
DOMAIN=ofenes.com

# --- Admin email (used for SSL certificate registration) ---
ADMIN_EMAIL=admin@ofenes.com

# --- Server ---
SERVER_PORT=8080

# --- JWT ---
# REQUIRED in production. Use a strong random string (32+ chars).
# In dev mode, a default is used automatically.
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_HOURS=24

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# In production (Docker), the host must be the service name "postgres", not localhost.
DATABASE_URL=postgres://ofenes:ofenes@postgres:5432/ofenes?sslmode=disable
DATABASE_POOL_SIZE=10

# PostgreSQL container credentials — must match the user/password in DATABASE_URL.
POSTGRES_USER=ofenes
POSTGRES_PASSWORD=ofenes
POSTGRES_DB=ofenes

# --- WebSocket ---
# Maximum incoming WebSocket message size in bytes.
WS_MAX_MESSAGE_SIZE=4096

# --- YouTube (Games) ---
# Required for the GuessTheSong game. Get a free key at:
# https://console.cloud.google.com → APIs & Services → YouTube Data API v3
# Free quota: 10,000 units/day (~100 game setups).
YOUTUBE_API_KEY=
